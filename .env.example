# ==============================================================================
# CoSpace — Global Environment Configuration Template
# Copy this file to .env at the root of the project:
#   cp .env.example .env
# ==============================================================================

# Application Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Frontend Applications (Vite)
# ------------------------------------------------------------------------------
# In Local Dev: http://localhost:3001
# In Production (Render): https://cospace-xqc7.onrender.com (backend root, no /api/client)
VITE_CLIENT_API_URL=http://localhost:3001
VITE_ADMIN_API_URL=http://localhost:3002/api/admin
VITE_GOOGLE_MAPS_API_KEY=mock_google_maps_key

# ------------------------------------------------------------------------------
# Backend Applications (Express REST APIs)
# ------------------------------------------------------------------------------
# Client Backend
CLIENT_BACKEND_PORT=3001
CLIENT_FRONTEND_URL=http://localhost:5173

# Admin Backend
ADMIN_BACKEND_PORT=3002
ADMIN_FRONTEND_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cospace_db

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=cospace_local_dev_jwt_secret_min_32_characters_long_12345
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# External Services & Integrations
# ------------------------------------------------------------------------------
# Cloudinary (Image/Asset Storage)
CLOUDINARY_CLOUD_NAME=cospace-demo
CLOUDINARY_API_KEY=mock_cloudinary_api_key
CLOUDINARY_API_SECRET=mock_cloudinary_api_secret

# Resend (Transactional Emails)
RESEND_API_KEY=re_mock_resend_api_key

# PayMongo (Payment Gateway)
PAYMONGO_SECRET_KEY=sk_test_mock_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_mock_paymongo_public_key

# Google Maps API (Backend Geocoding & Frontend Maps)
GOOGLE_MAPS_API_KEY=mock_google_maps_key
